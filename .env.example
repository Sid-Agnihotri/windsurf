# App
NEXT_PUBLIC_APP_URL=http://127.0.0.1:43123
BETTER_AUTH_URL=http://127.0.0.1:43123
BETTER_AUTH_SECRET=dev-secret-change-me-to-a-long-random-string

# Database
# Local default (no Neon required): SQLite file
SQLITE_PATH=./data/windsurf.db
# Neon / Postgres (production): set DATABASE_URL and switch Drizzle to postgres
# dialect — see README. Example:
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/windsurf?sslmode=require

# Stripe (optional for local — mock checkout works without these)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_EXPERT=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Google sign-in + Google Calendar (optional; the button appears once both are set)
# Console: https://console.cloud.google.com/apis/credentials  (OAuth client, type "Web application")
#   Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
#   Enable the "Google Calendar API"; add scope .../auth/calendar.events to the consent screen
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft sign-in + Outlook Calendar (optional; the button appears once both are set)
# Portal: https://entra.microsoft.com  > App registrations > New registration
#   Supported account types: "Accounts in any organizational directory and personal Microsoft accounts"
#   Redirect URI (Web): <BETTER_AUTH_URL>/api/auth/callback/microsoft
#   API permissions (delegated, Microsoft Graph): User.Read, offline_access, Calendars.ReadWrite
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" = personal + work/school accounts (default); or a specific tenant id
MICROSOFT_TENANT_ID=common

# Resend (optional — emails log to console without a key)
RESEND_API_KEY=
RESEND_FROM=Windsurf <onboarding@resend.dev>
